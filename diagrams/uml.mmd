classDiagram
    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task_id) void
        +edit_task(task_id, **changes) void
    }

    class Task {
        +str id
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str recurrence
        +bool completed
        +str pet_name
        +time start_time
        +time end_time
        +mark_complete() void
        +is_high_priority() bool
    }

    class Scheduler {
        +Owner owner
        +generate_daily_plan() list~Task~
        +sort_tasks(tasks) list~Task~
        +fits_in_time(task, minutes_left) bool
        +detect_conflicts(plan) list~Task~
        +explain_plan(plan) str
    }
    Owner "1" *-- "1..*" Pet : has
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders and selects
